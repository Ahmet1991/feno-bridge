{
  "manifest_version": 3,
  "name": "Feno Bridge PC2",
  "description": "Kendi Chrome sekmelerinizde görünür imleçle, pencere odağını değiştirmeden çalışır.",
  "version": "5.1.43",
  "key": "",
  "permissions": ["debugger", "tabs", "scripting", "nativeMessaging", "activeTab", "alarms", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "worker.js", "type": "module" },
  "action": { "default_title": "Feno Bridge PC2" },
  "incognito": "not_allowed"
}
